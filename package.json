{
  "name": "poko",
  "version": "0.1.0",
  "private": true,
  "description": "A local AI desktop agent with a friendly character-led interface.",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "pnpm native && electron-vite dev",
    "build": "pnpm native && electron-vite build",
    "dist": "pnpm build && node scripts/dist.mjs",
    "preview": "electron-vite preview",
    "native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.6",
    "@fontsource-variable/ibm-plex-sans": "^5.2.6",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
